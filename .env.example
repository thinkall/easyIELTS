# Owner-configured keys. Copy to .env.local and fill in. NEVER commit real values.
# Server-only — these are never sent to the browser.
GITHUB_MODELS_TOKEN=
GEMINI_API_KEY=

# Optional model overrides (safe defaults applied if unset)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Server
PORT=3000
# Bind address. Use 0.0.0.0 to be reachable via your machine's IP / a domain;
# use localhost (127.0.0.1) to restrict to the local machine only.
# When EASYIELTS_DOMAIN is set below, start.sh defaults this to 127.0.0.1 (the app
# runs privately behind the HTTPS proxy).
HOST=0.0.0.0

# HTTPS (used by start.sh, not the Node server). Set EASYIELTS_DOMAIN to your public
# domain to have start.sh configure an HTTPS reverse proxy on EASYIELTS_HTTPS_PORT
# (default 8443) via Caddy — required for the Speaking microphone. Leave blank to
# serve plain HTTP only. See deploy/ for details.
EASYIELTS_DOMAIN=
EASYIELTS_HTTPS_PORT=8443
